# Local-only Azure OCR fallback. Never commit real endpoint keys.
bbbee.azure.endpoint=https://YOUR-RESOURCE.cognitiveservices.azure.com/
bbbee.azure.key=REPLACE_WITH_AZURE_DOCUMENT_INTELLIGENCE_KEY

# S/4HANA Business Partner API Destination Service entry (HTTPS destination).
S4_BP_DESTINATION=S4HANA_BUSINESS_PARTNER
S4_BP_SERVICE_PATH=/sap/opu/odata/SAP/API_BUSINESS_PARTNER
# Default is safe dry-run. Set to live only after destination and extension field tests.
S4_SYNC_MODE=dry-run
# Map to deployed custom fields on the API_BUSINESS_PARTNER entity; never guess these names.
S4_FIELD_BBEE_LEVEL=
S4_FIELD_RECOGNITION_FACTOR=
S4_FIELD_CERTIFICATE_EXPIRY=
S4_FIELD_ENTERPRISE_TYPE=
S4_FIELD_COMPLIANCE_STATUS=
# Optional extension fields, only when they exist in the target S/4HANA system.
S4_FIELD_BLACK_OWNERSHIP=
S4_FIELD_BLACK_WOMEN_OWNERSHIP=

# Point this at an approved HTTPS adapter/API which actually sends email or notifications.
BEE_NOTIFICATION_DESTINATION=BB_BEE_NOTIFICATION_SERVICE
BEE_NOTIFICATION_PATH=/notifications
# For local development, log is used by default; production defaults to destination delivery.
BEE_NOTIFICATION_MODE=log
# Production expiry/outbox/notification scheduler defaults to enabled.
BB_BEE_AUTOMATION_ENABLED=true
BB_BEE_AUTOMATION_INTERVAL_MS=60000
