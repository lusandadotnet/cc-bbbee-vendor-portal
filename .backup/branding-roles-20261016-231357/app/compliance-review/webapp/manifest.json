{
  "_version": "1.89.0",
  "sap.app": {
    "id": "za.co.bbbee.compliancereview",
    "type": "application",
    "applicationVersion": { "version": "0.0.1" },
    "title": "B-BBEE Compliance Review",
    "description": "Review B-BBEE certificates and supplier onboarding requests.",
    "dataSources": {
      "mainService": { "uri": "/compliance/", "type": "OData", "settings": { "odataVersion": "4.0" } },
      "supplierService": { "uri": "/supplier/", "type": "OData", "settings": { "odataVersion": "4.0" } }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "rootView": { "viewName": "za.co.bbbee.compliancereview.view.Main", "type": "XML", "async": true, "id": "main" },
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": { "sap.m": {}, "sap.f": {}, "sap.ui.core": {}, "sap.ui.layout": {} }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "models": {},
    "resources": { "css": [{ "uri": "style.css" }] }
  },
  "sap.fiori": { "registrationIds": [], "archeType": "transactional" },
  "sap.cloud": { "service": "cc.bbbee.portal" }
}
